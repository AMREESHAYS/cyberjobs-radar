{
  // Static hosting for the PWA, behind a key check (src/index.js).
  // CI runs `wrangler deploy` after each fetch, so the phone always has fresh data.
  "name": "cyberjobs-radar",
  "main": "src/index.js",
  "compatibility_date": "2026-08-20",
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // without this, assets are served straight from the edge and the Worker
    // never runs — the gate would be dead code and the site public
    "run_worker_first": true
  },
  // provider for the on-demand application drafts; the key is a secret
  "vars": {
    "AI_BASE_URL": "https://api.groq.com/openai/v1",
    "AI_MODEL": "openai/gpt-oss-120b"
  },
  // saved/applied/notes/drafts, so a phone and a laptop agree
  "kv_namespaces": [
    { "binding": "STATE", "id": "605aa87e925845a3942530b0bc50c130" }
  ]
}
