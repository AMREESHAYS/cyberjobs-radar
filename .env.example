# Adzuna free key: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# --- AI provider (any OpenAI-compatible endpoint) ---
# AI_API_KEY is the generic key for whatever provider you point AI_BASE_URL at.
# Pick ONE provider:
#   Groq (free):    AI_API_KEY=<groq key>   (or leave in GROQ_API_KEY below; no base_url needed)
#   NVIDIA (free):  AI_API_KEY=nvapi-...     AI_BASE_URL=https://integrate.api.nvidia.com/v1
#                   AI_MODEL=meta/llama-3.3-70b-instruct   (get key at build.nvidia.com)
#   OpenRouter:     AI_API_KEY=sk-or-...     AI_BASE_URL=https://openrouter.ai/api/v1  AI_MODEL=...
#   Local Ollama:   AI_BASE_URL=http://localhost:11434/v1  AI_MODEL=llama3.1  (no key needed)
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# Groq key (legacy/fallback — still works; AI_API_KEY takes priority)
GROQ_API_KEY=
# Email digest (Phase 2) — optional. Gmail address + app password (not your login
# password): https://myaccount.google.com/apppasswords . DIGEST_TO = where to send.
GMAIL_USER=
GMAIL_APP_PASSWORD=
DIGEST_TO=

# web3.career jobs API token (free): https://web3.career/web3-jobs-api
WEB3CAREER_TOKEN=
